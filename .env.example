# XNOVA — server-side environment variables. Never commit real values.

# Solana
SOLANA_RPC_URL=
SOLSCAN_API_KEY=

# Wallet connectivity (thirdweb). Client id is public; the secret key is server-only.
THIRDWEB_CLIENT_ID=
THIRDWEB_SECRET_KEY=

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Existing Lovable AI gateway (keep for local/Lovable compatibility)
LOVABLE_API_KEY=

# Alert thresholds (optional)
XNOVA_ALERT_MIN_TRADE_USD=250
XNOVA_ALERT_WHALE_USD=5000
XNOVA_ALERT_PRICE_PCT=10

# EVM / Cronos (optional)
CRYPTO_COM_API_KEY=
CRYPTO_COM_API_SECRET=

# Optional infrastructure
DATABASE_URL=
REDIS_URL=
